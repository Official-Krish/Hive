# Copy to .env and fill in values.
NODE_ENV=development
PORT=4000
WS_PORT=4001
API_URL=http://localhost:4000
WS_URL=ws://localhost:4001
CLIENT_URLS=http://localhost:5173
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/postgres
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=change-me-at-least-32-chars-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# GitHub OAuth App (https://github.com/settings/apps) — replace with real values.
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/github/auth/callback
# Used to encrypt GitHub tokens at rest. Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=change-me-16-chars-min
LOG_LEVEL=info
# AI semantic issue matching (Nemotron/Gemini, OpenAI-compatible). Leave AI_PROVIDER empty to disable.
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Get a key at https://build.nvidia.com and export it here.
AI_API_KEY=your-nvidia-api-key
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_MIN_CONFIDENCE=0.6
