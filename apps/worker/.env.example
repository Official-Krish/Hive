NODE_ENV=development
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/postgres
LOG_LEVEL=info
PRESENCE_AWAY_SECONDS=120
PRESENCE_OFFLINE_SECONDS=900
WEBHOOK_RETENTION_DAYS=30
METRICS_INTERVAL_MS=900000
REAPER_INTERVAL_MS=3600000
PRESENCE_INTERVAL_MS=60000
FINALIZE_INTERVAL_MS=60000

# PR reviewer teammate (empty = review jobs fail gracefully with
# "reviewer not configured"). AI_MODEL is required for the model pass.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=

# GitHub App (same values as the backend) — used to mint installation
# tokens for fetching diffs and posting review comments.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=