NODE_ENV=development
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/postgres
LOG_LEVEL=info
PRESENCE_AWAY_SECONDS=120
PRESENCE_OFFLINE_SECONDS=900
WEBHOOK_RETENTION_DAYS=30
METRICS_INTERVAL_MS=900000
REAPER_INTERVAL_MS=3600000
PRESENCE_INTERVAL_MS=60000
FINALIZE_INTERVAL_MS=60000