{
  "name": "hive",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "cd packages/db && bun --bun run generate",
    "db:migrate": "cd packages/db && bun --bun run migrate dev",
    "db:studio": "cd packages/db && bun --bun run studio",
    "db:seed": "cd packages/db && bun --bun run db:seed",
    "redis:up": "docker compose up -d redis",
    "worker:dev": "bun --cwd apps/worker run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "bunx --bun eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
